{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "项目知识库": {
      "type": "local",
      "command": ["python", "/path/to/mcp_kb_server.py"],
      "enabled": true,
      "environment": {
        "KB_PATHS": "./specs,./knowledge,./docs,./config",
        "KB_EXTENSIONS": ".md,.json",
        "KB_MAX_SIZE_MB": "10"
      }
    }
  }
}
