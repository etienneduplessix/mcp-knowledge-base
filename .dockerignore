__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Documentation
*.md
!knowledge/*.md
!docs/*.md

# Logs
*.log

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# Local config
.env
.env.local
.env.*.local

# Don't ignore knowledge base files
!knowledge/
!docs/
!config/
